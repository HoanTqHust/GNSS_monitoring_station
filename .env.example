# Runtime configuration template.
# Copy to .env on the target device and fill device-specific values.
# Never commit real MQTT passwords or deployment secrets.

# Web server
HOSTSOCKET=0.0.0.0
PORTSOCKET=5000

# u-blox serial ports
PORT1=/dev/ttyACM0
PORT2=/dev/ttyACM1
PORT3=/dev/ttyACM2
BUFFER_SAMPLES=150
PLOT_INTERVAL=2.0
ELE_MASK=15

# RAM queues
RAM_INGRESS_QUEUE_SIZE=500000
RAM_DETECT_QUEUE_SIZE=200000
RAM_RAW_QUEUE_SIZE=500000
RAM_RAW_MQTT_QUEUE_SIZE=200000
RAM_QUEUE_POLL_INTERVAL=0.02
RAM_RAW_EMIT_BATCH_SIZE=100
RAM_HEALTH_PUBLISH_INTERVAL=1.0

# Only these identities are emitted to Raw UBX Stream and raw/ublox MQTT.
# Use * to pass through every parsed identity.
RAW_UBX_ALLOWED_IDENTITIES=RXM-RAWX,NAV-PVT,NAV-SAT,MON-SPAN

# Realtime GNSS spoofing detector thresholds
SOS_CARRIER_THRESHOLD=0.04
SOS_SMOOTHED_PSEUDORANGE_THRESHOLD=1.10
D3_CARRIER_SIMILARITY_THRESHOLD=0.001
D3_SMOOTHED_PSEUDORANGE_SIMILARITY_THRESHOLD=0.001
D3_MIN_CLUSTER_SIZE=3

# MQTT
# Keep disabled for local smoke tests. Enable only after provisioning a
# per-device EMQX account where MQTT_USERNAME equals MQTT_DEVICE_ID.
MQTT_ENABLED=0
MQTT_HOST=gnss.soict.io
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=gnss
MQTT_SITE_ID=default_site
MQTT_DEVICE_ID=device_abcd
MQTT_USERNAME=device_abcd
MQTT_PASSWORD=change-me-out-of-band
MQTT_QOS=1
MQTT_KEEPALIVE_S=60
MQTT_PUBLISH_TIMEOUT_S=2.0
MQTT_POSITION_RETAIN=0

# SDR common config
SDR_ENABLED=1
SDR_FREQ=1575420000
SDR_SAMPLE_RATE=5000000
SDR_GAIN=30
SDR_BANDWIDTH=2500000
SDR_NUM_SAMPLES=8192
SDR_SNAPSHOT_PRE_SECONDS=1.0
SDR_SNAPSHOT_POST_SECONDS=2.0
SDR_JAMMING_CONFIDENCE_THRESHOLD=0.90
SDR_MQTT_CHUNK_BYTES=65536
SDR_SNAPSHOT_DIR=output_sdr
SDR_SNAPSHOT_COOLDOWN_SECONDS=5.0
SDR_MQTT_QUEUE_SIZE=256

# Select exactly one SDR source.
# Option A: USRP X300 over Ethernet
SDR_SOURCE=usrp_x300
SDR_USRP_ADDR=192.168.5.111
SDR_USRP_ARGS=addr=192.168.5.111
SDR_USRP_CHANNEL=0
SDR_USRP_ANTENNA=
SDR_USRP_STREAM_ARGS=
SDR_USRP_RECV_TIMEOUT=1.0
SDR_USRP_SET_BANDWIDTH=0

# Option B: legacy bladeRF
# To use bladeRF, change SDR_SOURCE to bladerf and set SDR_DEVICE if needed.
SDR_DEVICE=libusb:device=6:3
